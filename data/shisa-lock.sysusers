# Password holder for the Shisa application lock. The administrator sets the password after install:
#   sudo passwd shisa-lock
# The account cannot log in and its home is /, it is used only for polkit authentication.
# /usr/sbin/nologin is the path Arch, Fedora, and Debian all provide.
u shisa-lock - "Shisa application lock" / /usr/sbin/nologin
