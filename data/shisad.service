[Unit]
Description=Shisa application lock
Documentation=https://github.com/RiverOnVenus/Shisa
After=dbus.service
Wants=dbus.service

[Service]
Type=notify
WatchdogSec=10
ExecStart=/usr/bin/shisad
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=1
# Each pending launch holds one fanotify event descriptor, capped at 64 per app
# and 256 per user. systemd's default soft limit is 1024, so multi-user systems
# or abuse can exhaust it, and a failed event read makes shisad exit.
LimitNOFILE=8192:524288
# shisad writes configuration changes back to /etc/shisa/users/. Under
# ProtectSystem=strict /etc is read-only and ConfigurationDirectory only creates
# the directory, so write access must be opened separately with ReadWritePaths.
ConfigurationDirectory=shisa/users
ReadWritePaths=/etc/shisa

# CAP_SYS_ADMIN enables fanotify_init. CAP_SYS_PTRACE lets shisad read other
# users' /proc/<pid>/exe, a path that goes through the ptrace access check and
# needs more than uid 0. CAP_DAC_READ_SEARCH lets it read user home directories,
# which are usually 0700, without it shisad cannot read desktop files in
# ~/.local/share/applications or mark user-level Flatpak entries.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# @system-service does not include fanotify_init and fanotify_mark (they are in
# @privileged), so allow just those two instead of opening all of @privileged.
SystemCallFilter=@system-service fanotify_init fanotify_mark
# Filtered calls return EPERM instead of killing the process. The default action
# is SIGSYS: a call outside the list would kill shisad, and the kernel would then
# release all pending requests, defeating the protection. With an error return
# only that authentication attempt fails and protection stays in place.
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
