// Shisa actions use a separate application lock password, held by the shisa-lock account.
// Other actions return null and continue to the wheel rule in 50-default.rules.
polkit.addAdminRule(function(action, subject) {
    if (action.id.indexOf("io.github.RiverOnVenus.Shisa.") === 0) {
        return ["unix-user:shisa-lock"];
    }
    return null;
});
